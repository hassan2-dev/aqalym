{
  "expo": {
    "name": "أقاليم",
    "slug": "aqalym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "aqalym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "iq.aqalym.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ar",
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لتحديد عنوان مشروع التركيب بدقة."
      }
    },
    "android": {
      "package": "iq.aqalym.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.jpg"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E275E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لتحديد عنوان مشروع التركيب بدقة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "ar": "./locales/ar.json"
    },
    "extra": {
      "eas": {
        "projectId": "aqalym-local-dev"
      }
    }
  }
}
